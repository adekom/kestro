# Copy to .env.local for local development. Never commit .env.local.

# Firebase web config. For the local emulator any placeholder works with the
# "demo-kestro" project ID.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kestro
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-kestro.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Point the browser SDK at the Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Point the Admin SDK at the Emulator Suite (remove in production).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Origin embedded in PDF photo links. Use your stable custom domain in production.
KESTRO_PUBLIC_BASE_URL=http://localhost:3000

# One-time first-administrator bootstrap secret. Choose a long random value.
KESTRO_BOOTSTRAP_SECRET=change-me-to-a-long-random-string
