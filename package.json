{
  "name": "kestro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:emulator": "node scripts/test-emulator.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage --import=./emulator-data --export-on-exit",
    "seed:dev": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.4",
    "pdfkit": "^0.17.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
