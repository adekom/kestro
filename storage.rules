rules_version = '2';

// Originals, derivatives and logos are private. Uploads and downloads are
// proxied by the server (Admin SDK) after authorization; public photo links
// are resolved server-side from revocable share tokens.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
