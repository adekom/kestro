rules_version = '2';

// Kestro reads and writes Firestore exclusively from the server through the
// Firebase Admin SDK, after validating the session and the user's role.
// Browsers never access Firestore directly, so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
